// Solution 1: Using HashSet for efficient word lookup
class HashSetDictionary {
   private Set<String> dictionary;
 
   public HashSetDictionary() {
       dictionary = new HashSet<>();
   }
 
   // Adds a word to the dictionary
   public void addWord(String word) {
       dictionary.add(word.toLowerCase());
   }
 
   // Checks if a word exists in the dictionary
   public boolean containsWord(String word) {
       return dictionary.contains(word.toLowerCase());
   }
 
   // Suggests corrections for a given word (basic implementation)
   public List<String> suggestCorrections(String word) {
       List<String> suggestions = new ArrayList<>();
       String lowerCaseWord = word.toLowerCase();
 
       // Check for words with one character difference (insertion, deletion, substitution)
       for (String dictWord : dictionary) {
           if (isOneEditDistance(lowerCaseWord, dictWord)) {
               suggestions.add(dictWord);
           }
       }
       return suggestions;
   }
 
   // Helper to check if two words are one edit distance apart
   private boolean isOneEditDistance(String s1, String s2) {
       int m = s1.length();
       int n = s2.length();
 
       if (Math.abs(m - n) > 1) {
           return false;
       }
 
       int i = 0, j = 0, count = 0;
       while (i < m && j < n) {
           if (s1.charAt(i) != s2.charAt(j)) {
               count++;
               if (count > 1) {
                   return false;
               }
               if (m > n) { // Deletion in s1
                   i++;
               } else if (n > m) { // Insertion in s1
                   j++;
               } else { // Substitution
                   i++;
                   j++;
               }
           } else {
               i++;
               j++;
           }
       }
 
       if (i < m || j < n) {
           count++;
       }
 
       return count == 1;
   }
}
